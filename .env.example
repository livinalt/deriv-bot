# PAT token from home.deriv.com → Settings → API Token
DERIV_API_TOKEN=enter_your_PAT_token_here
# App ID from developers.deriv.com → Dashboard → Apps
DERIV_APP_ID=enter_your_app_id_here
# "demo" or "real"
DERIV_ACCOUNT_TYPE=demo

# Telegram
TELEGRAM_BOT_TOKEN=enter_your_telegram_bot_token_here
TELEGRAM_CHAT_ID=enter_your_telegram_chat_id_here

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
